{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
    // tsconfig.json `paths` map self-imports (`@lousho/build-ai-agent[/sub]`,
    // used by agent-dir fixtures and every example) to src/, so this config,
    // typecheck:examples and `npx tsx examples/...` need no build. They live
    // there without comments: fallow cannot read a commented tsconfig.json.
    // examples/imports.test.ts keeps them in sync with package.json exports.
  },
  "include": ["src/**/*", "typings/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
