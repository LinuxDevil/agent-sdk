{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/cli/{dev,chat,build,studio,mcp,doctor,init,eval}.ts",
    "**/*.test-d.ts",
    "**/*.{test,spec}.{ts,tsx}",
    "**/*.eval.ts"
  ],
  "ignorePatterns": [
    ".claude/**"
  ],
  "dynamicallyLoaded": [
    "src/deploy/runtime.ts",
    "src/deploy/runtime.worker.ts",
    "src/deploy/shims/sandboxCore.worker.ts",
    "src/deploy/shims/node.worker.ts",
    "src/deploy/shims/quickjs.worker.ts",
    "src/deploy/shims/ollama.worker.ts",
    "src/deploy/shims/mcp.worker.ts",
    "src/agentDir/__fixtures__/**/*.{ts,js}",
    "examples/agent-dir/tools/*.ts"
  ],
  "ignoreDependencies": [
    "@ai-sdk/anthropic",
    "@ai-sdk/openai",
    "ollama-ai-provider",
    "ollama-ai-provider-v2",
    "prompts"
  ],
  "usedClassMembers": [
    {
      "implements": "TriggerAdapter",
      "members": [
        "type",
        "trigger",
        "listen"
      ]
    },
    {
      "implements": "CheckpointStore",
      "members": [
        "save",
        "load",
        "delete",
        "history"
      ]
    },
    {
      "implements": "ApprovalStore",
      "members": [
        "save",
        "load",
        "delete"
      ]
    }
  ],
  "overrides": [
    {
      "files": [
        "src/types/**"
      ],
      "rules": {
        "unused-enum-members": "off"
      }
    }
  ],
  "duplicates": {
    "ignore": [
      "**/*.test-d.ts"
    ]
  },
  "health": {
    "ignore": [
      "**/*.{test,spec}.{ts,tsx}",
      "**/*.test-d.ts",
      "**/*.eval.ts",
      "**/__fixtures__/**",
      "apps/agent-forge/e2e/**"
    ],
    "coverage": "coverage/coverage-final.json",
    "thresholdOverrides": [
      {
        "files": [
          "examples/**"
        ],
        "maxCrap": 150,
        "reason": "examples/* run manually (npm run example:*), never under the vitest coverage suite, so coverage-derived CRAP is maximal for all of them; cyclomatic/cognitive ceilings still apply."
      },
      {
        "files": [
          "src/agentDir/registryEnforce.ts",
          "src/deploy/workerAgentDir.ts"
        ],
        "maxCrap": 80,
        "reason": "Both files are ~94-100% statement-covered, but fallow's per-function CRAP matching scores their nested callbacks (.map(...) guards, the confined fetch) as 0%-covered. Ceiling exempts only the coverage term; cyclomatic/cognitive still gate."
      }
    ]
  }
}
