{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/cli/{dev,build,studio,mcp,doctor,init}.ts",
    "src/data/index.ts",
    "**/*.test-d.ts",
    "**/*.{test,spec}.{ts,tsx}",
    "**/*.eval.ts"
  ],
  "ignorePatterns": [
    ".claude/**"
  ],
  "dynamicallyLoaded": [
    "src/deploy/runtime.ts",
    "src/deploy/runtime.worker.ts",
    "src/deploy/shims/sandboxCore.worker.ts",
    "src/agentDir/__fixtures__/**/*.{ts,js}",
    "examples/agent-dir/tools/*.ts"
  ],
  "ignoreDependencies": [
    "@ai-sdk/anthropic",
    "@ai-sdk/openai",
    "ollama-ai-provider"
  ],
  "usedClassMembers": [
    {
      "implements": "TriggerAdapter",
      "members": [
        "type",
        "trigger",
        "listen"
      ]
    },
    {
      "implements": "CheckpointStore",
      "members": [
        "save",
        "load",
        "delete"
      ]
    },
    {
      "implements": "ApprovalStore",
      "members": [
        "save",
        "load",
        "delete"
      ]
    }
  ],
  "overrides": [
    {
      "files": [
        "src/types/**"
      ],
      "rules": {
        "unused-enum-members": "off"
      }
    }
  ],
  "health": {
    "ignore": [
      "**/*.{test,spec}.{ts,tsx}",
      "**/*.eval.ts",
      "**/__fixtures__/**",
      "apps/agent-forge/e2e/**"
    ],
    "coverage": "coverage/coverage-final.json"
  }
}
