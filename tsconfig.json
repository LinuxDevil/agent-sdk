{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "paths": {
      "@linuxdevil/lousho": ["./src/index.ts"],
      "@linuxdevil/lousho/executor": ["./src/executor/index.ts"],
      "@linuxdevil/lousho/tools": ["./src/tools/index.ts"],
      "@linuxdevil/lousho/flows": ["./src/flows/index.ts"],
      "@linuxdevil/lousho/integrations": ["./src/integrations/index.ts"],
      "@linuxdevil/lousho/utils": ["./src/utils/index.ts"],
      "@linuxdevil/lousho/improve": ["./src/improve/index.ts"],
      "@linuxdevil/lousho/goals": ["./src/goals/index.ts"],
      "@linuxdevil/lousho/workspaces": ["./src/workspaces/index.ts"],
      "@linuxdevil/lousho/workspaces/client": ["./src/workspaces/client/index.ts"],
      "@linuxdevil/lousho/mcp": ["./src/tools/mcp/index.ts"],
      "@linuxdevil/lousho/observe": ["./src/observe/index.ts"],
      "@linuxdevil/lousho/types": ["./src/types/index.ts"],
      "@linuxdevil/lousho/spec": ["./src/spec/v2/index.ts"],
      "@linuxdevil/lousho/testing": ["./src/testing/index.ts"],
      "@linuxdevil/lousho/otel": ["./src/execution/otel.ts"],
      "@linuxdevil/lousho/hooks": ["./src/execution/hooks.ts"],
      "@linuxdevil/lousho/sqlite": ["./src/storage/sqlite/index.ts"],
      "@linuxdevil/lousho/auth": ["./src/auth/index.ts"],
      "@linuxdevil/lousho/kv": ["./src/deploy/kv.ts"],
      "@linuxdevil/lousho/worker": ["./src/deploy/worker.ts"],
      "@linuxdevil/lousho/traces": ["./src/traces/index.ts"],
      "@linuxdevil/lousho/triggers": ["./src/triggers/index.ts"],
      "@linuxdevil/lousho/react": ["./src/react/index.ts"],
      "@linuxdevil/lousho/vue": ["./src/vue/index.ts"],
      "@linuxdevil/lousho/svelte": ["./src/svelte/index.ts"]
    }
  },
  "include": ["src/**/*", "typings/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/*.test-d.ts"]
}
