{
  "name": "@linuxdevil/studio",
  "version": "0.1.0-alpha.0",
  "description": "Lousho Studio: build, test and watch every agent across your projects. A local web app for @linuxdevil/lousho.",
  "type": "module",
  "bin": {
    "lousho-studio": "dist-server/cli.cjs"
  },
  "files": [
    "dist",
    "dist-server",
    "!dist-server/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinuxDevil/agent-sdk.git",
    "directory": "apps/agent-forge"
  },
  "homepage": "https://lousho.com/introduction",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src server shared evals",
    "lint:imports": "eslint -c eslint.imports.config.mjs src server shared evals e2e --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "server:build": "tsup --config server/tsup.config.ts",
    "server:start:prod": "node dist-server/index.cjs",
    "build:studio": "npm run build && npm run server:build",
    "prepack": "node scripts/pin-sdk-range.mjs pin",
    "postpack": "node scripts/pin-sdk-range.mjs restore",
    "test:server": "vitest run -c server/vitest.config.ts",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p evals/tsconfig.json",
    "eval:author": "tsx evals/author/run.ts",
    "test:bridge-compat": "vitest run -c server/vitest.compat.config.ts",
    "test:e2e:studio": "npm run build:studio && playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@linuxdevil/lousho": "file:../..",
    "ai": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.12.0",
    "diff": "^8.0.4",
    "elkjs": "^0.9.3",
    "express": "^5.2.1",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.63.0",
    "ollama-ai-provider": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.11",
    "vitest": "^1.0.0",
    "ws": "^8.18.3"
  }
}
