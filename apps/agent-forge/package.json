{
  "name": "@loushy/agent-forge",
  "version": "0.0.1",
  "private": true,
  "description": "Agent Forge - visual dashboard for creating, running and debugging agents built with @loushy/build-ai-agent (LOU-L: app shell & data model).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src server",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "server:build": "tsup --config server/tsup.config.ts",
    "server:start:prod": "node dist-server/index.cjs",
    "build:studio": "npm run build && npm run server:build",
    "test:server": "vitest run -c server/vitest.config.ts",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "test:e2e:studio": "npm run build:studio && playwright test"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@loushy/build-ai-agent": "file:../..",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "cors": "^2.8.5",
    "dagre": "^0.8.5",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^0.0.42",
    "@ai-sdk/openai": "^0.0.42",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/dagre": "^0.7.52",
    "@types/express": "^5.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "ollama-ai-provider": "^1.2.0",
    "supertest": "^7.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^1.0.0"
  }
}
