    "@ai-sdk/openai": "^0.0.42",
    "@types/dagre": "^0.7.52",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "ollama-ai-provider": "^1.2.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^1.0.0"
