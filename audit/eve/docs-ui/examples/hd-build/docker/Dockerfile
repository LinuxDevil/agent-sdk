# Generated by `lousho build --target=docker`.
FROM node:22-slim
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev
COPY dist/ ./dist/
ENV NODE_ENV=production
# Listen on all interfaces inside the container so `docker run -p` can reach it.
ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000
CMD ["node", "dist/server.js"]
