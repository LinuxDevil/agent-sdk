{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lousho.com/schemas/lousho.page.v1.json",
  "title": "lousho.page/1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "lousho.page/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "harness": {
      "type": "object",
      "properties": {
        "extends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overrides": {
          "type": "string"
        }
      },
      "required": [
        "extends"
      ],
      "additionalProperties": false
    },
    "agents": {
      "type": "string"
    },
    "execution": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "single",
            "multi-agent",
            "workflow",
            "goal-oriented"
          ]
        },
        "single": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "agent"
          ],
          "additionalProperties": false
        },
        "multiAgent": {
          "type": "object",
          "properties": {
            "lead": {
              "type": "string",
              "minLength": 1
            },
            "delegates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "lead"
          ],
          "additionalProperties": false
        },
        "workflow": {
          "type": "object",
          "properties": {
            "workflow": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "./workflow.json"
                },
                {
                  "type": "string",
                  "pattern": "^workspace:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                }
              ]
            }
          },
          "required": [
            "workflow"
          ],
          "additionalProperties": false
        },
        "goal": {
          "type": "object",
          "properties": {
            "lead": {
              "type": "string",
              "minLength": 1
            },
            "delegates": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "goal": {
              "type": "string",
              "const": "./goal.json"
            }
          },
          "required": [
            "lead",
            "goal"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxDurationMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxTurns": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxCostUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "onFailure": {
          "type": "string",
          "enum": [
            "return-to-main",
            "stop",
            "ask"
          ]
        },
        "checkpoint": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "improve": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\/\\S+$"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "local"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "harness",
    "execution"
  ],
  "additionalProperties": false
}
