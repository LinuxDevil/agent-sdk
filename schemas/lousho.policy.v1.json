{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lousho.com/schemas/lousho.policy.v1.json",
  "title": "lousho workspace policy",
  "type": "object",
  "properties": {
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_*?-]{1,128}$"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_*?-]{1,128}$"
                },
                "minItems": 1
              }
            ]
          },
          "when": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "eq": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "ne": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "lt": {
                      "type": "number"
                    },
                    "lte": {
                      "type": "number"
                    },
                    "gt": {
                      "type": "number"
                    },
                    "gte": {
                      "type": "number"
                    },
                    "matches": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "propertyNames": {
              "minLength": 1
            }
          },
          "action": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "ask",
              "auto"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "ttlMs": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "tool",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\*|[A-Za-z0-9_-]{1,127}\\*?)$"
          }
        }
      },
      "required": [
        "allow"
      ],
      "additionalProperties": false
    },
    "secrets": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "env": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "required": [
              "env"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "secret": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              }
            },
            "required": [
              "secret"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "allowHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "allowHosts"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "properties": {
        "require": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\*|[A-Za-z0-9_-]{1,127}\\*?)$"
          }
        }
      },
      "required": [
        "require"
      ],
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "permissions",
    "tools",
    "secrets"
  ],
  "additionalProperties": false
}
