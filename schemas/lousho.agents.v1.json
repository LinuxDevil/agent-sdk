{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lousho.agents/1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "lousho.agents/1"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "as": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "ref": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\/\\S+$"
          },
          "limits": {
            "type": "object",
            "properties": {
              "maxDurationMs": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "maxTurns": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "maxCostUsd": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          "tools": {
            "type": "object",
            "properties": {
              "only": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "as",
          "ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "agents"
  ],
  "additionalProperties": false
}
