{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lousho.com/schemas/lousho.harness.v1.json",
  "title": "lousho.harness/1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "lousho.harness/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*)?(?:\\+[0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*)?$"
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "traits": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "schema": {}
      },
      "required": [
        "schema"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "schema": {},
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "mediaType": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "mediaType"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "require": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][\\w-]*(?:\\.[A-Za-z][\\w-]*)*$"
          }
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "type": "string",
                "minLength": 1
              },
              "rubric": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "criteria"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "maxDurationMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxTurns": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxCostUsd": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "modelHints": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "reasoning": {
              "type": "string",
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema"
  ],
  "additionalProperties": false
}
