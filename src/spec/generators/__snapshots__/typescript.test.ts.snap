// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`specToCode > renders a spec with every section 1`] = `
"// Generated by lousho from AgentSpec v2 'a'. Edit the spec, not this file.
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { createAgent, guardrailsFromSpec, handoffFromSpec, hooksFromSpec, jsonSchemaToStandardSchema, memoryFromSpec, outputFromSpec, permissionsFromSpec, resolveMcpServers, resolveSkillRef, resolveToolRef, specV2ToAgent, subagentFromSpec } from 'lousho';

/** Where relative paths in the spec start, and how named secrets resolve (environment variables here). */
const host = { baseDir: path.dirname(fileURLToPath(import.meta.url)), resolveSecret: (name: string) => process.env[name], resolveHandoffAgent: async (name: string) => subagents[name] };

const subagents = {
  helper: await subagentFromSpec('helper', {
    inline: {
      name: 'helper',
      model: 'mock/m',
      instructions: 'Help.',
      description: 'Helps.',
    },
  }, { ...host, buildAgent: (s) => specV2ToAgent({ version: 2, ...s }, host) }),
};

export const agent = createAgent({
  name: 'a',
  description: 'Does everything.',
  model: 'mock/m',
  fallbackModels: ['mock/f1', 'mock/f2'],
  instructions: \`You are a test agent.\`,
  prompt: 'support@prod',
  modelSettings: { maxTokens: 64, temperature: 0.2 },
  reasoning: 'low',
  tools: Object.assign({}, ...(await Promise.all([
    resolveToolRef({ builtin: 'current_date' }, { ...host, agentName: 'a' }, 'tools.0'),
    resolveToolRef({ hosted: 'web_search' }, { ...host, agentName: 'a' }, 'tools.1'),
  ]))),
  mcpServers: await resolveMcpServers({
    docs: {
      url: 'https://x.test/mcp',
      headers: { Authorization: { env: 'HDR' }, 'X-Key': { secret: 'tok' } },
    },
  }, host),
  skills: (await Promise.all([
    resolveSkillRef({
      inline: { name: 'changelog', description: 'Write changelogs.', content: '# C' },
    }, host),
  ])).flat(),
  memory: await Promise.all([
    memoryFromSpec({
      name: 'notes',
      scope: 'session',
      provider: { type: 'in-memory' },
      itemJsonSchema: { type: 'object', properties: { text: { type: 'string' } } },
      itemKey: 'text',
    }, { ...host, toStandardSchema: jsonSchemaToStandardSchema }),
  ]),
  subagents,
  subagentOptions: { maxConcurrent: 2 },
  maxSubagentDepth: 2,
  handoffs: await Promise.all([
    handoffFromSpec({ agent: 'helper', description: 'Go helper.' }, host, 0),
  ]),
  maxHandoffs: 4,
  guardrails: guardrailsFromSpec([
    {
      id: 'g1',
      name: 'deny-topics',
      on: 'input',
      options: { topics: ['weapons'] },
    },
  ]),
  permissions: permissionsFromSpec([{ id: 'p1', tool: '*', action: 'allow' }]).rules,
  permissionMode: 'plan',
  approvalTtlMs: 60000,
  askQuestion: true,
  hooks: await hooksFromSpec([
    {
      id: 'h1',
      inline: { name: 'noop', point: 'postGenerate', code: 'return;' },
    },
  ], host),
  output: outputFromSpec({
    jsonSchema: {
      type: 'object',
      properties: { city: { type: 'string' } },
      required: ['city'],
    },
  }),
  limits: { maxSteps: 7 },
  maxSteps: 9,
  compaction: { thresholdPercent: 0.5 },
  retry: { maxRetries: 4, backoff: { initialMs: 10 } },
  rateLimit: { requestsPerMinute: 12 },
  promptCaching: 'auto',
  toolSearch: { maxResults: 3 },
  codeMode: { timeoutMs: 1000 },
});

// triggers, abortListeners, flow and evals are run by lousho dev / Studio, not by createAgent():
export const spec = { triggers: [{ id: 't1', type: 'chat' }] } as const;
"
`;
