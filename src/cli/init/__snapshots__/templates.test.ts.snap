    "dev:ui": "lousho dev src/agent.ts",
    "telegram": "tsx src/index.ts --telegram",
    "task": "tsx src/index.ts --task-file",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "doctor": "lousho doctor src/agent.ts",
    "build": "lousho build src/agent.ts --target=node-server"
  },
