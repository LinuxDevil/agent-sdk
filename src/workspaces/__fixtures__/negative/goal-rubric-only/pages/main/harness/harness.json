{
  "schema": "lousho.harness/1",
  "instructions": [
    "harness/task.md"
  ],
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string"
        }
      },
      "required": [
        "task"
      ]
    }
  },
  "outputs": {
    "schema": {
      "type": "object",
      "properties": {
        "report": {
          "type": "string"
        }
      },
      "required": [
        "report"
      ]
    }
  },
  "evaluation": {
    "criteria": [
      {
        "id": "report-present",
        "description": "The report is not empty.",
        "check": "harness/checks/report-present.ts"
      },
      {
        "id": "reads-well",
        "description": "Reads well.",
        "rubric": "Clear and short."
      }
    ]
  }
}
