{
  "schema": "lousho.page/1",
  "id": "instagram-videos",
  "name": "Instagram",
  "description": "Makes an Instagram video from a topic.",
  "harness": {
    "extends": [
      "workspace:platforms/instagram",
      "workspace:content-types/educational",
      "workspace:audiences/general"
    ]
  },
  "execution": {
    "type": "workflow",
    "workflow": {
      "workflow": "workspace:video-production"
    },
    "multiAgent": {
      "lead": "script",
      "delegates": [
        "video",
        "voice"
      ]
    },
    "goal": {
      "lead": "script",
      "delegates": [
        "video",
        "voice"
      ],
      "goal": "./goal.json"
    },
    "onFailure": "return-to-main"
  }
}
