  "instructions": "### From workspace:platforms/instagram\n\nSound like a person, not a brochure.\n\nLead with a hook in the first line.\n\n### From workspace:formats/educational\n\nExplain one idea with one example.\n\n### From global:audiences/general@1.2.0\n\nAssume no prior knowledge.\n\n### From page\n\nWrite the weekly tip post.",
  "audience": {
    "description": "A general audience.",
    "traits": {
      "tone": "playful",
      "persona": "creator",
      "level": "beginner"
    }
  },
  "platform": {
    "id": "instagram",
    "requirements": {
      "aspectRatio": "4:5",
      "captionMaxChars": 1000,
      "hashtags": {
        "max": 10,
        "banned": [
          "#ad"
        ]
      }
    }
  },
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "brief": {
          "type": "string"
        }
      },
      "required": [
        "brief"
      ]
    }
  },
  "outputs": {
    "schema": {
      "allOf": [
        {
          "type": "object",
          "properties": {
            "caption": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "caption"
          ]
        }
      ]
    },
    "artifacts": [
      {
        "name": "image",
        "mediaType": "image/jpeg",
        "required": true
      },
      {
        "name": "caption",
        "mediaType": "text/plain"
      }
    ]
  },
  "capabilities": {
    "require": [
      "image.generate",
      "web.search"
    ]
  },
  "constraints": [
    {
      "id": "caption-length",
      "text": "Keep the caption under 2200 characters."
    },
    {
      "id": "one-idea",
      "text": "Teach one idea per post."
    },
    {
      "id": "no-jargon",
      "text": "Avoid jargon."
    },
    {
      "id": "cta",
      "text": "End with one call to action."
    }
  ],
  "evaluation": {
    "criteria": [
