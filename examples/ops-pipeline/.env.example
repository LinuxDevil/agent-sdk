# All of these are OPTIONAL - the default `npm run pipeline:demo` runs
# entirely against mocks/ and needs none of them set.

# Real Slack Incoming Webhook URL (src/tools/built-in/slack.ts).
SLACK_WEBHOOK_URL=

# Real LLM provider credentials, only used if you wire a real LLMProvider
# into startOpsPipeline({ provider }) instead of the default demoProvider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Real GitHub token, owner/repo, only used if you wire a real GitHubTools
# instance into startOpsPipeline({ githubCreatePrTool }) instead of the
# default mock GitHub tool.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
