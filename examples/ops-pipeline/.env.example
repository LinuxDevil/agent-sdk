# All optional: `npm run pipeline:demo` runs entirely against mocks/.
# These are read from the process environment (export them in your shell);
# the example does not load a .env file.

# Local listener ports (defaults shown).
MONITOR_PORT=8787
SLACK_PORT=8788

# When set, POST /slack/interactions verifies X-Slack-Signature.
SLACK_SIGNING_SECRET=
