{
  "name": "@loushy/build-ai-agent",
  "version": "1.0.0-alpha.8",
  "description": "Framework-agnostic SDK for building AI agents",
  "workspaces": [
    "apps/*"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "loushy": "bin/loushy.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.mjs",
      "require": "./dist/tools/index.js"
    },
    "./flows": {
      "types": "./dist/flows/index.d.ts",
      "import": "./dist/flows/index.mjs",
      "require": "./dist/flows/index.js"
    },
    "./mcp": {
      "types": "./dist/tools/mcp/index.d.ts",
      "import": "./dist/tools/mcp/index.mjs",
      "require": "./dist/tools/mcp/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./testing": {
      "types": "./dist/data/mocks.d.ts",
      "import": "./dist/data/mocks.mjs",
      "require": "./dist/data/mocks.js"
    },
    "./otel": {
      "types": "./dist/execution/otel.d.ts",
      "import": "./dist/execution/otel.mjs",
      "require": "./dist/execution/otel.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.eval.ts",
    "!src/**/__fixtures__",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "./src/providers/mock.ts",
    "./src/providers/mock.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "test:evals:judge": "vitest run --config vitest.judge.config.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "example:tracing:console": "tsx examples/tracing/run-console.ts",
    "example:tracing:otel": "tsx examples/tracing/run-otel.ts",
    "example:support-bot": "tsx examples/support-bot/index.ts",
    "example:research-assistant": "tsx examples/research-assistant/index.ts",
    "example:workflow-router": "tsx examples/workflow-router/index.ts",
    "example:doc-qa": "tsx examples/doc-qa/index.ts",
    "example:slack-notifier": "tsx examples/slack-notifier/index.ts",
    "pipeline:demo": "tsx examples/ops-pipeline/index.ts",
    "pipeline:demo:trigger": "tsx examples/ops-pipeline/mocks/sendSyntheticError.ts",
    "prepublishOnly": "npm run build",
    "docs:build": "typedoc",
    "docs:verify-snippets": "tsx scripts/verify-docs-snippets.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "openai",
    "chatbot",
    "workflow",
    "automation",
    "framework-agnostic",
    "loushy",
    "build-ai-agent"
  ],
  "author": "Loushy Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LinuxDevil/agent-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/LinuxDevil/agent-sdk/issues"
  },
  "homepage": "https://github.com/LinuxDevil/agent-sdk#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^0.0.42",
    "@ai-sdk/openai": "^0.0.42",
    "@opentelemetry/api": "^1.9.1",
    "ai": "^4.3.19",
    "ollama-ai-provider": "^1.2.0",
    "tsup": "^8.0.0",
    "zod": "^3.25.76"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "ollama-ai-provider": {
      "optional": true
    },
    "tsup": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dockerode": "^5.0.1",
    "nanoid": "^5.0.7",
    "undici": "^8.11.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^0.0.42",
    "@ai-sdk/openai": "^0.0.42",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^10.11.0",
    "selfsigned": "^5.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^1.0.0",
    "wrangler": "^4.143.0"
  }
}
