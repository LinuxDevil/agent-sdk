      },
      "require": {
        "types": "./dist/svelte/index.d.ts",
        "default": "./dist/svelte/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "executor": [
        "dist/executor/index.d.ts"
      ],
      "tools": [
        "dist/tools/index.d.ts"
      ],
      "flows": [
        "dist/flows/index.d.ts"
      ],
      "integrations": [
        "dist/integrations/index.d.ts"
      ],
      "utils": [
        "dist/utils/index.d.ts"
      ],
      "mcp": [
        "dist/tools/mcp/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ],
      "otel": [
        "dist/execution/otel.d.ts"
