      ],
      "auth": [
        "dist/auth/index.d.ts"
      ],
      "kv": [
        "dist/deploy/kv.d.ts"
      ],
      "worker": [
        "dist/deploy/worker.d.ts"
      ],
      "traces": [
        "dist/traces/index.d.ts"
      ],
      "triggers": [
