{
  "name": "@lousho/build-ai-agent",
  "version": "1.0.0-alpha.24",
  "description": "TypeScript AI agent SDK with tools, MCP, durable sessions, human approvals, and OpenTelemetry. Runs in your own Node process.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "lousho": "bin/lousho.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./executor": {
      "import": {
        "types": "./dist/executor/index.d.mts",
        "default": "./dist/executor/index.mjs"
      },
      "require": {
