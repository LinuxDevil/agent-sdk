      ],
      "vue": [
        "dist/vue/index.d.ts"
      ],
      "svelte": [
        "dist/svelte/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/cli/*.js",
    "!dist/**/*.map",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.testkit.ts",
    "!src/**/*.eval.ts",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/__cassettes__",
    "bin",
    "apps/agent-forge/package.json",
    "apps/agent-forge/dist",
    "apps/agent-forge/dist-server",
    "!apps/agent-forge/dist-server/*.map",
    "README.md",
    "llms.txt",
    "docs/*.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": [
    "./src/providers/index.ts",
    "./src/providers/index.js",
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "scripts": {
    "build": "node --max-old-space-size=12288 node_modules/tsup/dist/cli-default.js",
    "dev": "node --max-old-space-size=12288 node_modules/tsup/dist/cli-default.js --watch",
    "pre-release": "npm version prerelease --preid=alpha --no-git-tag-version && node scripts/sync-version.mjs && npm publish --access public --tag alpha",
    "pre-release:create-lousho-agent": "npm version prerelease --preid=alpha --no-git-tag-version -w create-lousho-agent && npm run build -w create-lousho-agent && npm publish -w create-lousho-agent --access public --tag alpha",
    "release:create-lousho-agent": "npm version patch --no-git-tag-version -w create-lousho-agent && npm run build -w create-lousho-agent && npm publish -w create-lousho-agent --access public",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:evals:judge": "vitest run --config vitest.judge.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "test:types": "tsc -p tsconfig.test-d.json && vitest run --typecheck.only",
    "example:tracing:console": "tsx examples/tracing/run-console.ts",
    "example:tracing:otel": "tsx examples/tracing/run-otel.ts",
    "example:agent-dir": "tsx examples/agent-dir/index.ts",
    "example:support-bot": "tsx examples/support-bot/index.ts",
    "example:research-assistant": "tsx examples/research-assistant/index.ts",
    "example:workflow-router": "tsx examples/workflow-router/index.ts",
    "example:doc-qa": "tsx examples/doc-qa/index.ts",
    "example:plan-mode": "tsx examples/plan-mode/index.ts",
    "example:slack-notifier": "tsx examples/slack-notifier/index.ts",
    "example:support-desk": "tsx examples/support-desk/index.ts",
    "example:deep-research": "tsx examples/deep-research/index.ts",
    "example:data-analyst": "tsx examples/data-analyst/index.ts",
    "example:evaluator-loop": "tsx examples/evaluator-loop/index.ts",
    "example:waves": "tsx examples/waves/index.ts",
    "example:phase-pipeline": "tsx examples/phase-pipeline/index.ts",
    "example:coding-agent-workflows": "tsx examples/coding-agent-workflows/index.ts",
    "example:connectors": "tsx examples/connectors/index.ts",
    "pipeline:demo": "tsx examples/ops-pipeline/index.ts",
    "pipeline:demo:trigger": "tsx examples/ops-pipeline/mocks/sendSyntheticError.ts",
    "build:studio": "npm run build:studio --workspace apps/agent-forge",
    "test:e2e:studio": "npm run test:e2e:studio --workspace apps/agent-forge",
    "prepublishOnly": "npm run build && npm run build:studio",
    "prepack": "node scripts/prepack-check.mjs",
    "docs:build": "typedoc",
    "docs:ratchet": "tsx scripts/typedoc-ratchet.ts",
    "docs:ratchet:update": "tsx scripts/typedoc-ratchet.ts --update",
    "docs:verify-snippets": "tsx scripts/verify-docs-snippets.ts",
    "api:update": "tsx scripts/api-report.ts",
    "api:check": "tsx scripts/api-report.ts --check",
    "docs:llms": "tsx scripts/generate-llms-txt.ts",
    "docs:llms:check": "tsx scripts/generate-llms-txt.ts --check",
    "fallow": "fallow",
    "fallow:score": "fallow health --score",
    "example:openrouter": "tsx examples/openrouter/index.ts",
    "size-check": "tsx scripts/size-check.ts",
    "pack-smoke": "tsx scripts/pack-smoke.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:check": "tsx scripts/build-registry.ts --check",
    "registry-smoke": "tsx scripts/registrySmoke.ts"
  },
  "keywords": [
    "typescript",
    "ai-agents",
    "ai-agent",
    "llm",
    "mcp",
    "model-context-protocol",
    "tool-calling",
    "openai",
    "anthropic",
    "ollama",
    "opentelemetry",
    "vercel-ai-sdk",
    "lousho",
    "build-ai-agent"
  ],
