        "default": "./dist/testing/index.js"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/execution/otel.d.mts",
        "default": "./dist/execution/otel.mjs"
      },
      "require": {
        "types": "./dist/execution/otel.d.ts",
        "default": "./dist/execution/otel.js"
      }
